# ─── Featherless (Qwen VL vision + text LLM) ─────────────────────────────────
FEATHERLESS_API_KEY=your_featherless_api_key_here
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
VISION_MODEL=Qwen/Qwen2.5-VL-32B-Instruct
# Optional: cheaper text-only model for router/response nodes (leave empty to use VISION_MODEL)
TEXT_MODEL=Qwen/Qwen2.5-72B-Instruct

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# ⚠️  Note: Supabase URL always ends in .supabase.co (not .com)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Telegram ─────────────────────────────────────────────────────────────────
# Create your bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# ─── Email / Resend (secondary notification channel) ──────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=AngebotsBot <noreply@yourdomain.de>

# ─── Chainlit ─────────────────────────────────────────────────────────────────
CHAINLIT_AUTH_SECRET=change_me_to_a_long_random_secret_string

# ─── Scraper settings ─────────────────────────────────────────────────────────
KAUFDA_MAX_PAGES_PER_CATEGORY=3
KAUFDA_MAX_OFFERS_PER_RUN=200
SCRAPER_INTER_PAGE_DELAY_MIN=1.5
SCRAPER_INTER_PAGE_DELAY_MAX=3.0

# Embeddings: werden automatisch von der Supabase generate-embedding Edge Function
# generiert (gte-small, 384-dim) — kein lokales Modell / kein GPU nötig

# ─── Scheduler ────────────────────────────────────────────────────────────────
# Weekly scrape: day_of_week + hour in Europe/Berlin time
SCRAPE_CRON_DAY_OF_WEEK=mon
SCRAPE_CRON_HOUR=8

# ─── App ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
APP_TIMEZONE=Europe/Berlin
