# ─── Google Gemini (vision + text LLM) ────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
VISION_MODEL=gemini-2.5-flash
TEXT_MODEL=gemini-2.5-flash

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# ⚠️  Note: Supabase URL always ends in .supabase.co (not .com)
# anon key — public, shipped in the dashboard browser bundle. RLS limits it to reads.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# service_role key — NEVER ship to a browser. Used by the Python bot to write data.
# Find it in Supabase Dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Telegram ─────────────────────────────────────────────────────────────────
# Create your bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# ─── Email / Resend (secondary notification channel) ──────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=AngebotsBot <noreply@yourdomain.de>

# ─── Chainlit ─────────────────────────────────────────────────────────────────
CHAINLIT_AUTH_SECRET=change_me_to_a_long_random_secret_string

# ─── Scraper settings ─────────────────────────────────────────────────────────
KAUFDA_MAX_PAGES_PER_CATEGORY=3
KAUFDA_MAX_OFFERS_PER_RUN=200
SCRAPER_INTER_PAGE_DELAY_MIN=1.5
SCRAPER_INTER_PAGE_DELAY_MAX=3.0

# Embeddings: werden automatisch von der Supabase generate-embedding Edge Function
# generiert (gte-small, 384-dim) — kein lokales Modell / kein GPU nötig

# ─── Scheduler ────────────────────────────────────────────────────────────────
# Weekly scrape: day_of_week + hour in Europe/Berlin time
SCRAPE_CRON_DAY_OF_WEEK=mon
SCRAPE_CRON_HOUR=8

# ─── App ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
APP_TIMEZONE=Europe/Berlin
